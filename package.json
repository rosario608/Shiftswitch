{
  "name": "shiftswitch",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:reset": "tsx scripts/migrate.ts --reset",
    "db:seed": "tsx scripts/seed.ts",
    "db:setup": "npm run db:reset && npm run db:seed",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "setup:local": "tsx scripts/setup-local.ts",
    "verify": "tsx scripts/verify.ts",
    "verify:fast": "tsx scripts/verify.ts --fast",
    "e2e:fixture": "tsx scripts/e2e-fixture.ts",
    "check:release": "tsx scripts/check-release-env.ts",
    "test:e2e:mobile": "playwright test --config playwright.mobile.config.ts",
    "mobile:build": "npm --prefix mobile run build",
    "mobile:test": "npm --prefix mobile run test",
    "mobile:version": "node mobile/scripts/set-version.mjs",
    "lint:mobile": "eslint --config mobile/eslint.config.mjs mobile/src mobile/scripts",
    "setup:production": "tsx scripts/setup-production.ts",
    "demo:seed": "tsx scripts/demo.ts seed",
    "demo:reset": "tsx scripts/demo.ts reset",
    "demo:status": "tsx scripts/demo.ts status",
    "migrations:manifest": "tsx scripts/generate-migration-manifest.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.5.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.1",
    "exceljs": "^4.4.0",
    "jose": "^6.2.5",
    "lucide-react": "^1.28.0",
    "luxon": "^3.7.2",
    "next": "16.2.12",
    "pdfkit": "^0.19.1",
    "pg": "^8.22.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.83.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
