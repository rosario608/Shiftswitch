<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing this app stores should leave the device in a backup or a
    device-to-device transfer: the session token is a credential, and the
    cached schedule is personal data. A new install signs in again.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
