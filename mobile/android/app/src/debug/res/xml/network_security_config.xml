<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only. Allows a local development server over http and trusts
    certificates installed on the device so traffic can be inspected. This file
    is in src/debug and is never part of a release artifact.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
