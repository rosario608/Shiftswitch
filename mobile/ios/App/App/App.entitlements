<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
		Push notifications. `development` is correct for debug builds and for
		TestFlight; Xcode rewrites it to `production` when the archive is
		exported for the App Store.
	-->
	<key>aps-environment</key>
	<string>development</string>

	<!--
		Universal Links. The host must serve
		/.well-known/apple-app-site-association (the server generates it) and
		must match VITE_API_URL in mobile/.env.production — iOS compares the
		host in this file against the one the link came from, exactly.

		This carried the generated placeholder host from the day the project was
		created — something no build would reject and no test could see: the app
		compiles, installs, runs, and silently opens its own links in Safari.
		`mobile/src/native/ios-config.test.ts` fails if a placeholder ever
		returns, which is why that test refuses any example host anywhere in
		this file, comments included.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:shiftswitch.vercel.app</string>
	</array>
</dict>
</plist>
