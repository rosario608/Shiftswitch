# ---------------------------------------------------------------------------
# ShiftSwitch environment configuration
# Copy to .env.local for local development. Never commit real secrets.
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Supabase: Project Settings -> Database -> URI).
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shiftswitch_dev
# Separate database used by `npm run test:integration`. Wiped on every run.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/shiftswitch_test
# Set to "true" when the database requires TLS (most hosted providers do).
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Public origin of the app. Must match the Google OAuth redirect URI host.
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=ShiftSwitch

# --- Google OAuth / OpenID Connect -----------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict the Google account chooser to one Workspace domain.
GOOGLE_HOSTED_DOMAIN=

# 32+ byte random string used to sign OAuth state and session cookies.
# Generate with: openssl rand -base64 48
AUTH_SECRET=

# Session lifetime in days.
SESSION_TTL_DAYS=30

# --- Bootstrap --------------------------------------------------------------
# Comma-separated emails granted the `admin` role on first login when the
# database has no admin yet. Leave empty in production once set up.
BOOTSTRAP_ADMIN_EMAILS=

# --- Invitation email (optional) ---------------------------------------------
# The single credential that turns on automatic invitation delivery. Leave it
# empty and invitations still work: the administrator copies the link or sends
# the pre-filled mailto: from their own mailbox. See docs/ONBOARDING.md.
RESEND_API_KEY=
INVITATION_FROM_ADDRESS=

# --- Test-only ---------------------------------------------------------------
# Enables POST /api/auth/test-login for automated end-to-end tests.
# Ignored unless NODE_ENV !== 'production'. Never enable in production.
ALLOW_TEST_LOGIN=false
